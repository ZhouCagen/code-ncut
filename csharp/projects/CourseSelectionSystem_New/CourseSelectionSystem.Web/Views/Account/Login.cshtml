@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-cn">
<head>
    <meta charset="utf-8" />
    <title>登录 - 选课系统</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="login-page">
    <form class="login-card" asp-controller="Account" asp-action="Login" method="post">
        <h1>选课系统登录</h1>

        @if (ViewBag.Error != null)
        {
            <div class="alert error">@ViewBag.Error</div>
        }

        <label>账号</label>
        <input name="account" placeholder="请输入账号" />

        <label>密码</label>
        <input name="password" type="password" placeholder="请输入密码" />

        <button type="submit">登录</button>
    </form>
</body>
</html>
